<script>
(function() {
// Prevent duplicate declarations by using IIFE
if (window.customerSelectionInitialized) {
    return;
}
window.customerSelectionInitialized = true;

let allCustomers = [];
let filteredCustomers = [];
let selectedCustomerId = null;
window.customerCurrentFilter = 'all';

// Customer selection modal functions
window.openCustomerSelectionModal = function(callback) {
    window.customerSelectionCallback = callback;
    selectedCustomerId = null;
    
    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('customerSelectionModal'));
    modal.show();
    
    // Load customers
    loadCustomers();
}

window.loadCustomers = function() {
    // Show loader
    document.getElementById('customerListLoader').classList.remove('d-none');
    document.getElementById('customerList').classList.add('d-none');
    document.getElementById('noCustomersFound').classList.add('d-none');
    
    // Fetch customers from API
    fetch('/customers/api/list')
        .then(response => response.json())
        .then(data => {
            // API returns array directly, not {success, customers}
            if (Array.isArray(data)) {
                allCustomers = data;
            } else if (data.success) {
                allCustomers = data.customers || [];
            } else {
                allCustomers = [];
                console.error('API Error:', data.error);
            }
            window.applyCurrentFilter();
            hideLoader();
        })
        .catch(error => {
            console.error('Error loading customers:', error);
            hideLoader();
            showNoCustomersFound();
        });
}

function hideLoader() {
    document.getElementById('customerListLoader').classList.add('d-none');
}

window.applyCurrentFilter = function() {
    let filtered = [...allCustomers];
    
    console.log('applyCurrentFilter called with filter:', window.customerCurrentFilter);
    console.log('All customers count:', allCustomers.length);
    
    // Apply filter
    switch(window.customerCurrentFilter) {
        case 'recent':
            // Sort by created_at (most recently added first) - show only 5
            filtered = filtered.sort((a, b) => {
                const dateA = new Date(a.created_at || a.updated_at || 0);
                const dateB = new Date(b.created_at || b.updated_at || 0);
                return dateB - dateA;
            }).slice(0, 5);
            break;
        case 'frequent':
            // Sort by booking count (most frequent first)
            filtered = filtered.sort((a, b) => (b.booking_count || 0) - (a.booking_count || 0)).slice(0, 20);
            break;
        default:
            // All customers - sort alphabetically
            filtered = filtered.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
    }
    
    console.log('Filtered customers count:', filtered.length);
    filteredCustomers = filtered;
    renderCustomerList();
}

function renderCustomerList() {
    const customerList = document.getElementById('customerList');
    const searchTerm = document.getElementById('customerSelectionSearchInput').value.toLowerCase();
    
    // Filter by search term
    let displayCustomers = filteredCustomers;
    if (searchTerm) {
        displayCustomers = filteredCustomers.filter(customer => 
            (customer.name || '').toLowerCase().includes(searchTerm) ||
            (customer.email || '').toLowerCase().includes(searchTerm) ||
            (customer.phone || '').toLowerCase().includes(searchTerm) ||
            (customer.company || '').toLowerCase().includes(searchTerm)
        );
    }
    
    if (displayCustomers.length === 0) {
        showNoCustomersFound();
        return;
    }
    
    // Render customer items
    customerList.innerHTML = displayCustomers.map(customer => `
        <div class="customer-item" onclick="selectCustomer(${customer.id})" data-customer-id="${customer.id}">
            <div class="customer-name">${customer.name || 'Unnamed Customer'}</div>
            <div class="customer-details">
                ${customer.email || ''} ${customer.phone ? '• ' + customer.phone : ''}
                ${customer.company ? '• ' + customer.company : ''}
            </div>
            <div class="customer-meta">
                <div class="customer-meta-item">
                    <i class="fas fa-calendar"></i>
                    <span>${customer.created_at ? new Date(customer.created_at).toLocaleDateString() : 'N/A'}</span>
                </div>
                <div class="customer-meta-item">
                    <i class="fas fa-suitcase"></i>
                    <span class="customer-stats">${customer.booking_count || 0} bookings</span>
                </div>
            </div>
        </div>
    `).join('');
    
    customerList.classList.remove('d-none');
    document.getElementById('noCustomersFound').classList.add('d-none');
}

function showNoCustomersFound() {
    document.getElementById('customerList').classList.add('d-none');
    document.getElementById('noCustomersFound').classList.remove('d-none');
}

window.selectCustomer = function(customerId) {
    selectedCustomerId = customerId;
    
    // Update visual selection
    document.querySelectorAll('.customer-item').forEach(item => {
        item.classList.remove('selected');
    });
    
    const selectedItem = document.querySelector(`[data-customer-id="${customerId}"]`);
    if (selectedItem) {
        selectedItem.classList.add('selected');
    }
    
    // Find customer data
    const customer = allCustomers.find(c => c.id === customerId);
    
    // Close modal using data-bs-dismiss approach
    const modalEl = document.getElementById('customerSelectionModal');
    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
    modal.hide();
    
    // Call callback with full customer object
    if (window.customerSelectionCallback && customer) {
        window.customerSelectionCallback(customer);
    }
}

window.applyCustomerFilter = function(btn, filter) {
    console.log('applyCustomerFilter called with filter:', filter);
    
    // Update active state
    document.querySelectorAll('#customerSelectionModal .filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    
    // Apply filter
    window.customerCurrentFilter = filter;
    window.applyCurrentFilter();
}

window.showNewCustomerForm = function() {
    // Hide customer selection modal
    const customerModal = bootstrap.Modal.getInstance(document.getElementById('customerSelectionModal'));
    if (customerModal) {
        customerModal.hide();
    }
    
    // Show quick add modal
    const quickAddModal = new bootstrap.Modal(document.getElementById('quickAddCustomerModal'));
    quickAddModal.show();
    
    // Clear form
    document.getElementById('quickAddCustomerForm').reset();
}

window.quickAddCustomer = function() {
    const form = document.getElementById('quickAddCustomerForm');
    const formData = new FormData(form);
    
    // Convert to JSON - include all fields from the form
    const data = {
        first_name: formData.get('first_name'),
        last_name: formData.get('last_name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        customer_type: formData.get('customer_type') || 'Direct',
        company_name: formData.get('company_name'),
        tax_number: formData.get('tax_number'),
        address: formData.get('address'),
        city: formData.get('city'),
        country: formData.get('country'),
        notes: formData.get('notes')
    };
    
    // Validate required fields
    if (!data.first_name) {
        alert('Please fill in the first name (required)');
        return;
    }
    if (!data.email) {
        alert('Please fill in the email (required)');
        return;
    }
    if (!data.phone) {
        alert('Please fill in the phone (required)');
        return;
    }
    
    // Show loading state
    const submitBtn = document.getElementById('quickAddSubmitBtn');
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
    
    // Get CSRF token
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 
                     document.querySelector('input[name="csrf_token"]')?.value || '';
    
    // Send to API
    fetch('/customers/api/create', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRFToken': csrfToken
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            // Close quick add modal
            const quickAddModal = bootstrap.Modal.getInstance(document.getElementById('quickAddCustomerModal'));
            quickAddModal.hide();
            
            // Reload customers and select the new one
            loadCustomers();
            
            // Show success message
            setTimeout(() => {
                if (window.customerSelectionCallback) {
                    window.customerSelectionCallback(result.customer.id, result.customer.name);
                }
                
                // Reopen customer selection modal
                const customerModal = new bootstrap.Modal(document.getElementById('customerSelectionModal'));
                customerModal.show();
            }, 500);
        } else {
            alert('Error adding customer: ' + (result.error || 'Unknown error'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error adding customer. Please try again.');
    })
    .finally(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
    });
}

