# DO NOT commit real values
# Live database (the live website). Only the deploy script uses it.
DATABASE_URL_LIVE=postgresql://user:password@host/dbname?sslmode=require
# Local database (your computer, for testing)
DATABASE_URL_LOCAL=postgresql://user:password@host/testdb?sslmode=require

# Flask
SESSION_SECRET=change-me-to-a-random-32-char-string
FLASK_ENV=development

# AI features (optional)
OPENAI_API_KEY=sk-...

# Cloud Storage (optional — local fallback used if unset)
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
