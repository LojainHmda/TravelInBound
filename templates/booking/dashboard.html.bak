{% extends 'base.html' %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <h2><i class="fas fa-tachometer-alt me-2"></i>Service Execution Dashboard</h2>
            <a href="{{ url_for('new_booking') }}" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>New Booking
            </a>
        </div>
        <hr>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="background-color: var(--status-planned); color: white;">
            <div class="stat-card-body">
                <div class="stat-card-icon">
                    <i class="fas fa-clipboard-list"></i>
                </div>
                <div class="stat-card-info">
                    <h3>{{ status_counts.get('PLANNED', 0) }}</h3>
                    <p>Planned</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background-color: var(--status-prepaid); color: white;">
            <div class="stat-card-body">
                <div class="stat-card-icon">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div class="stat-card-info">
                    <h3>{{ status_counts.get('PREPAID', 0) }}</h3>
                    <p>Prepaid</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background-color: var(--status-queued); color: black;">
            <div class="stat-card-body">
                <div class="stat-card-icon">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="stat-card-info">
                    <h3>{{ status_counts.get('QUEUED', 0) }}</h3>
                    <p>Queued</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="background-color: var(--status-processing); color: white;">
            <div class="stat-card-body">
                <div class="stat-card-icon">
                    <i class="fas fa-spinner"></i>
                </div>
                <div class="stat-card-info">
                    <h3>{{ status_counts.get('PROCESSING', 0) }}</h3>
                    <p>Processing</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background-color: var(--status-confirmed); color: white;">
            <div class="stat-card-body">
                <div class="stat-card-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-card-info">
                    <h3>{{ status_counts.get('CONFIRMED', 0) }}</h3>
                    <p>Confirmed</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card" style="background-color: var(--status-closed); color: white;">
            <div class="stat-card-body">
                <div class="stat-card-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <div class="stat-card-info">
                    <h3>{{ status_counts.get('CLOSED', 0) }}</h3>
                    <p>Closed</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <ul class="nav nav-tabs card-header-tabs" id="servicesTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active text-dark" id="flights-tab" data-bs-toggle="tab" data-bs-target="#flights" type="button" role="tab" aria-controls="flights" aria-selected="true">
                            <i class="fas fa-plane me-2"></i>Flights
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-dark" id="hotels-tab" data-bs-toggle="tab" data-bs-target="#hotels" type="button" role="tab" aria-controls="hotels" aria-selected="false">
                            <i class="fas fa-hotel me-2"></i>Hotels
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-dark" id="transport-tab" data-bs-toggle="tab" data-bs-target="#transport" type="button" role="tab" aria-controls="transport" aria-selected="false">
                            <i class="fas fa-car me-2"></i>Transport
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-dark" id="visa-tab" data-bs-toggle="tab" data-bs-target="#visa" type="button" role="tab" aria-controls="visa" aria-selected="false">
                            <i class="fas fa-passport me-2"></i>Visa
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-dark" id="insurance-tab" data-bs-toggle="tab" data-bs-target="#insurance" type="button" role="tab" aria-controls="insurance" aria-selected="false">
                            <i class="fas fa-shield-alt me-2"></i>Insurance
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="servicesTabContent">
                    <!-- Flights Tab -->
                    <div class="tab-pane fade show active" id="flights" role="tabpanel" aria-labelledby="flights-tab">
                        <h4 class="service-title"><i class="fas fa-plane me-2 text-primary"></i>Flight Services</h4>
                        {% if service_items.flight %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Booking Ref</th>
                                        <th>Description</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in service_items.flight %}
                                    <tr>
                                        <td>{{ item.booking.reference_number }}</td>
                                        <td>{{ item.description }}</td>
                                        <td>{{ item.start_date.strftime('%Y-%m-%d') }} to {{ item.end_date.strftime('%Y-%m-%d') }}</td>
                                        <td>${{ "%.2f"|format(item.amount) }}</td>
                                        <td>
                                            <span class="badge status-{{ item.status.lower() }}">{{ item.status }}</span>
                                        </td>
                                        <td>
                                            <a href="{{ url_for('booking_details', booking_id=item.booking.id) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-plane fa-3x text-muted mb-3"></i>
                            <p>No flight services found</p>
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- Hotels Tab -->
                    <div class="tab-pane fade" id="hotels" role="tabpanel" aria-labelledby="hotels-tab">
                        <h4 class="service-title"><i class="fas fa-hotel me-2 text-success"></i>Hotel Services</h4>
                        {% if service_items.hotel %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Booking Ref</th>
                                        <th>Description</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in service_items.hotel %}
                                    <tr>
                                        <td>{{ item.booking.reference_number }}</td>
                                        <td>{{ item.description }}</td>
                                        <td>{{ item.start_date.strftime('%Y-%m-%d') }} to {{ item.end_date.strftime('%Y-%m-%d') }}</td>
                                        <td>${{ "%.2f"|format(item.amount) }}</td>
                                        <td>
                                            <span class="badge status-{{ item.status.lower() }}">{{ item.status }}</span>
                                        </td>
                                        <td>
                                            <a href="{{ url_for('booking_details', booking_id=item.booking.id) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-hotel fa-3x text-muted mb-3"></i>
                            <p>No hotel services found</p>
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- Transport Tab -->
                    <div class="tab-pane fade" id="transport" role="tabpanel" aria-labelledby="transport-tab">
                        <h4 class="service-title"><i class="fas fa-car me-2 text-warning"></i>Transport Services</h4>
                        {% if service_items.transport %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Booking Ref</th>
                                        <th>Description</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in service_items.transport %}
                                    <tr>
                                        <td>{{ item.booking.reference_number }}</td>
                                        <td>{{ item.description }}</td>
                                        <td>{{ item.start_date.strftime('%Y-%m-%d') }} to {{ item.end_date.strftime('%Y-%m-%d') }}</td>
                                        <td>${{ "%.2f"|format(item.amount) }}</td>
                                        <td>
                                            <span class="badge status-{{ item.status.lower() }}">{{ item.status }}</span>
                                        </td>
                                        <td>
                                            <a href="{{ url_for('booking_details', booking_id=item.booking.id) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-car fa-3x text-muted mb-3"></i>
                            <p>No transport services found</p>
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- Visa Tab -->
                    <div class="tab-pane fade" id="visa" role="tabpanel" aria-labelledby="visa-tab">
                        <h4 class="service-title"><i class="fas fa-passport me-2 text-info"></i>Visa Services</h4>
                        {% if service_items.visa %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Booking Ref</th>
                                        <th>Description</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in service_items.visa %}
                                    <tr>
                                        <td>{{ item.booking.reference_number }}</td>
                                        <td>{{ item.description }}</td>
                                        <td>{{ item.start_date.strftime('%Y-%m-%d') }} to {{ item.end_date.strftime('%Y-%m-%d') }}</td>
                                        <td>${{ "%.2f"|format(item.amount) }}</td>
                                        <td>
                                            <span class="badge status-{{ item.status.lower() }}">{{ item.status }}</span>
                                        </td>
                                        <td>
                                            <a href="{{ url_for('booking_details', booking_id=item.booking.id) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-passport fa-3x text-muted mb-3"></i>
                            <p>No visa services found</p>
                        </div>
                        {% endif %}
                    </div>
                    
                    <!-- Insurance Tab -->
                    <div class="tab-pane fade" id="insurance" role="tabpanel" aria-labelledby="insurance-tab">
                        <h4 class="service-title"><i class="fas fa-shield-alt me-2 text-danger"></i>Insurance Services</h4>
                        {% if service_items.insurance %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Booking Ref</th>
                                        <th>Description</th>
                                        <th>Dates</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in service_items.insurance %}
                                    <tr>
                                        <td>{{ item.booking.reference_number }}</td>
                                        <td>{{ item.description }}</td>
                                        <td>{{ item.start_date.strftime('%Y-%m-%d') }} to {{ item.end_date.strftime('%Y-%m-%d') }}</td>
                                        <td>${{ "%.2f"|format(item.amount) }}</td>
                                        <td>
                                            <span class="badge status-{{ item.status.lower() }}">{{ item.status }}</span>
                                        </td>
                                        <td>
                                            <a href="{{ url_for('booking_details', booking_id=item.booking.id) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="text-center py-4">
                            <i class="fas fa-shield-alt fa-3x text-muted mb-3"></i>
                            <p>No insurance services found</p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
