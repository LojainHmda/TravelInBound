    <script>
    (function () {
        var PHONE_MSG = 'Only digits (0–9), spaces, and + are allowed.';
        var PHONE_RE = /^[0-9 +]*$/;

        /* Selectors that identify phone inputs across the whole app */
        var PHONE_NAMES = [
            'input[name="phone"]',
            'input[name="guide_phone"]',
            'input[name="contact_phone"]',
            'input[name="hotel_phone"]',
            'input[name="transport_phone"]',
            'input[name="driver_phone"]',
            'input[name="telephone_number"]',
            'input[type="tel"]',
        ];
        var PHONE_IDS = [
            '#newCustomerPhone', '#customerPhone', '#quick_phone',
            '#new_airline_phone', '#new_hotel_phone', '#new_restaurant_phone',
            '#new_transport_phone', '#new_guide_phone', '#new_ma_rep_phone',
            '#guide_phone',
        ];
        var SELECTOR = PHONE_NAMES.concat(PHONE_IDS).join(', ');

        function getOrCreateError(input) {
            var id = input.id || input.name;
            var errId = 'phone-err-' + id;
            var existing = input.parentNode && input.parentNode.querySelector('#' + errId);
            if (existing) return existing;
            var span = document.createElement('span');
            span.id = errId;
            span.className = 'phone-error-msg';
            span.setAttribute('role', 'alert');
            input.insertAdjacentElement('afterend', span);
            return span;
        }

        function validate(input) {
            var val = input.value;
            if (val && !PHONE_RE.test(val)) {
                input.classList.add('phone-invalid');
                getOrCreateError(input).textContent = PHONE_MSG;
                return false;
            } else {
                input.classList.remove('phone-invalid');
                var errSpan = input.parentNode && input.parentNode.querySelector('[id^="phone-err-"]');
                if (errSpan) errSpan.textContent = '';
                return true;
            }
        }

        /* Live validation on input */
        document.addEventListener('input', function (e) {
            if (e.target.matches && e.target.matches(SELECTOR)) {
                validate(e.target);
            }
        }, true);

        /* Block submit if any phone field is invalid */
        document.addEventListener('submit', function (e) {
            var form = e.target;
            var inputs = form.querySelectorAll(SELECTOR);
            var ok = true;
            inputs.forEach(function (inp) {
                if (!validate(inp)) {
                    ok = false;
                    inp.focus();
                }
            });
            if (!ok) e.preventDefault();
        }, true);

        /* Also validate on blur so error shows immediately after tab-out */
        document.addEventListener('blur', function (e) {
            if (e.target.matches && e.target.matches(SELECTOR)) {
                validate(e.target);
            }
        }, true);
    })();
    </script>
    
    


<script>
(function () {
    const MA_REP_OTHER_CONFIG = [
        { id: 'new_ma_rep_languages', key: 'meetassist_hub_languages' },
        { id: 'new_ma_rep_payment_terms', key: 'meetassist_hub_payment_terms' },
        { id: 'new_ma_rep_default_currency', key: 'meetassist_hub_default_currency' }
    ];
    const selectedMaRepLanguages = [];
    let globalMaRepLanguagesCache = [];

    function ensureOption(selectEl, value) {
        const val = String(value || '').trim();
        if (!selectEl || !val) return false;
        const exists = Array.from(selectEl.options).some(opt => (opt.value || '').toLowerCase() === val.toLowerCase());
        if (exists) return false;
        const option = document.createElement('option');
        option.value = val;
        option.textContent = val;
        const otherOption = Array.from(selectEl.options).find(opt => opt.value === 'Other');
        if (otherOption) selectEl.insertBefore(option, otherOption);
        else selectEl.appendChild(option);
        return true;
    }

    function openCustomPrompt(message, onSubmit) {
        const existingOverlay = document.getElementById('custom-prompt-overlay');
        if (existingOverlay) existingOverlay.remove();
        const overlay = document.createElement('div');
        overlay.id = 'custom-prompt-overlay';
        overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:99999;';
        const dialog = document.createElement('div');
        dialog.style.cssText = 'background:white;border-radius:12px;padding:24px;min-width:360px;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.3);';
        dialog.innerHTML = `
            <div style="font-size:14px;font-weight:600;color:#1e293b;margin-bottom:12px;">${message}</div>
            <input type="text" id="custom-prompt-input" style="width:100%;padding:8px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;outline:none;box-sizing:border-box;" placeholder="Type value..." autofocus>
            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
                <button type="button" id="custom-prompt-cancel" style="padding:6px 16px;border:1px solid #cbd5e1;border-radius:6px;background:#f8fafc;color:#475569;font-size:12px;cursor:pointer;">Cancel</button>
                <button type="button" id="custom-prompt-ok" style="padding:6px 16px;border:none;border-radius:6px;background:#3b82f6;color:white;font-size:12px;cursor:pointer;font-weight:500;">Add</button>
            </div>
        `;
        overlay.appendChild(dialog);
        document.body.appendChild(overlay);
        const input = document.getElementById('custom-prompt-input');
        const okBtn = document.getElementById('custom-prompt-ok');
        const cancelBtn = document.getElementById('custom-prompt-cancel');
        const submit = () => {
            const value = (input?.value || '').trim();
            overlay.remove();
            onSubmit(value);
        };
        const cancel = () => overlay.remove();
        okBtn?.addEventListener('click', submit);
        cancelBtn?.addEventListener('click', cancel);
        input?.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') submit();
            if (e.key === 'Escape') cancel();
        });
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) cancel();
        });
        setTimeout(() => input?.focus(), 50);
    }

    async function fetchGlobalOptionValues(key) {
        try {
            const resp = await fetch(`/inbound/api/supplier-option-values/global?key=${encodeURIComponent(key)}`);
            const data = await resp.json();
            if (data && data.success && Array.isArray(data.values)) {
                return data.values
                    .map(v => String(v || '').trim())
                    .filter(Boolean);
            }
        } catch (_) {}
        return [];
    }

    async function persistGlobalOptionValue(key, value) {
        const v = String(value || '').trim();
        if (!key || !v) return false;
        try {
            const resp = await fetch('/inbound/api/supplier-option-values/global', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ key: key, value: v })
            });
            const data = await resp.json();
            return !!(resp.ok && data && data.success);
        } catch (_) {
            return false;
        }
    }

    function updateSelectedMaRepLanguagesDisplay() {
        const container = document.getElementById('selected_ma_rep_languages');
        const hiddenInput = document.getElementById('new_ma_rep_languages_hidden');
        if (!container || !hiddenInput) return;
        container.innerHTML = '';
        selectedMaRepLanguages.forEach((lang, index) => {
            const badge = document.createElement('span');
            badge.className = 'inline-flex items-center px-2 py-1 bg-teal-100 text-teal-800 text-xs rounded-full';
            badge.innerHTML = `
                ${lang}
                <button type="button" class="ml-1 text-teal-600 hover:text-teal-800" onclick="removeMaRepLanguage(${index})">
                    <i class="fas fa-times text-xs"></i>
                </button>
            `;
            container.appendChild(badge);
        });
        hiddenInput.value = selectedMaRepLanguages.join(', ');
    }

    window.removeMaRepLanguage = function removeMaRepLanguage(index) {
        selectedMaRepLanguages.splice(index, 1);
        updateSelectedMaRepLanguagesDisplay();
    };

    function attachMaRepLanguageSelection() {
        const select = document.getElementById('new_ma_rep_languages');
        if (!select || select.dataset.maRepLangAttached === '1') return;
        select.dataset.maRepLangAttached = '1';
        select.addEventListener('change', function () {
            const selectedValue = this.value;
            if (!selectedValue) return;
            if (selectedValue === 'Other') {
                openCustomPrompt('Enter new language:', async function (customLanguage) {
                    const val = String(customLanguage || '').trim();
                    if (!val) {
                        select.value = '';
                        return;
                    }
                    ensureOption(select, val);
                    if (!selectedMaRepLanguages.includes(val)) selectedMaRepLanguages.push(val);
                    updateSelectedMaRepLanguagesDisplay();
                    select.value = '';
                    await persistGlobalOptionValue('meetassist_hub_languages', val);
                    globalMaRepLanguagesCache = await fetchGlobalOptionValues('meetassist_hub_languages');
                    globalMaRepLanguagesCache.forEach(lang => ensureOption(select, lang));
                });
                return;
            }
            if (!selectedMaRepLanguages.includes(selectedValue)) {
                selectedMaRepLanguages.push(selectedValue);
                updateSelectedMaRepLanguagesDisplay();
            }
            this.value = '';
        });
    }

    async function hydrateMaRepOtherValues() {
        for (const cfg of MA_REP_OTHER_CONFIG) {
            const selectEl = document.getElementById(cfg.id);
            if (!selectEl) continue;
            const values = await fetchGlobalOptionValues(cfg.key);
            if (cfg.key === 'meetassist_hub_languages') globalMaRepLanguagesCache = values.slice();
            values.forEach(v => ensureOption(selectEl, v));
            if (cfg.id === 'new_ma_rep_languages') continue;
            if (selectEl.dataset.otherHandlerAttached === '1') continue;
            selectEl.dataset.otherHandlerAttached = '1';
            selectEl.addEventListener('change', function () {
                if (selectEl.value !== 'Other') return;
                openCustomPrompt('Enter new value:', async function (customValue) {
                    const val = String(customValue || '').trim();
                    if (!val) {
                        selectEl.value = '';
                        return;
                    }
                    ensureOption(selectEl, val);
                    selectEl.value = val;
                    await persistGlobalOptionValue(cfg.key, val);
                });
            });
        }
    }

    function buildSupplierFormData(payload, fileInputId) {
        const formData = new FormData();
        Object.keys(payload || {}).forEach(key => {
            formData.append(key, payload[key] == null ? '' : String(payload[key]));
        });
        const fileInput = fileInputId ? document.getElementById(fileInputId) : null;
        if (fileInput && fileInput.files && fileInput.files[0]) {
            formData.append('contract_file', fileInput.files[0]);
        }
        return formData;
    }

    function applyCliqAndContractToSupplierDialog(prefix) {
        if (typeof window.bindSupplierPaymentMethodFields === 'function') {
            window.bindSupplierPaymentMethodFields(prefix);
        }
        const taxInput = document.getElementById(`${prefix}_tax_number`);
        const bankAccountInput = document.getElementById(`${prefix}_bank_account`);
        if (!taxInput || !bankAccountInput) return;
        const taxWrap = taxInput.closest('div');
        if (!taxWrap) return;

        const existingContractInput = document.getElementById(`${prefix}_contract_file`);
        let contractWrap = document.getElementById(`${prefix}_contract_wrap`);
        if (!existingContractInput && !contractWrap) {
            contractWrap = document.createElement('div');
            contractWrap.id = `${prefix}_contract_wrap`;
            const labelClass = 'block text-xs font-medium text-slate-700 mb-0.5';
            contractWrap.innerHTML = `
                <label class="${labelClass}">Contract Attachment</label>
                <input type="file" id="${prefix}_contract_file" class="${bankAccountInput.className || ''}" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
            `;
            taxWrap.insertAdjacentElement('afterend', contractWrap);
        }
    }

    function initMeetAssistRepresentativePopupEnhancements() {
        applyCliqAndContractToSupplierDialog('new_ma_rep');
        attachMaRepLanguageSelection();
        hydrateMaRepOtherValues().then(() => {
            const langSelect = document.getElementById('new_ma_rep_languages');
            if (langSelect && Array.isArray(globalMaRepLanguagesCache)) {
                globalMaRepLanguagesCache.forEach(lang => ensureOption(langSelect, lang));
            }
        });
    }

    window.openAddMeetAssistRepresentativeModal = function openAddMeetAssistRepresentativeModal() {
        const modal = document.getElementById('addMeetAssistRepresentativeModal');
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.style.display = 'flex';
        initMeetAssistRepresentativePopupEnhancements();
        document.getElementById('new_ma_rep_name')?.focus();
    };

    window.closeAddMeetAssistRepresentativeModal = function closeAddMeetAssistRepresentativeModal() {
        if (typeof window.addRepresentativeTargetSelectId !== 'undefined') {
            window.addRepresentativeTargetSelectId = null;
        }
        const modal = document.getElementById('addMeetAssistRepresentativeModal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.style.display = 'none';
        document.getElementById('new_ma_rep_supplier_type').value = '';
        document.getElementById('new_ma_rep_name').value = '';
        selectedMaRepLanguages.length = 0;
        updateSelectedMaRepLanguagesDisplay();
        const select = document.getElementById('new_ma_rep_languages');
        if (select) select.value = '';
        document.getElementById('new_ma_rep_phone').value = '';
        document.getElementById('new_ma_rep_email').value = '';
        document.getElementById('new_ma_rep_city').value = '';
        document.getElementById('new_ma_rep_country').value = 'Jordan';
        document.getElementById('new_ma_rep_payment_terms').value = '';
        document.getElementById('new_ma_rep_payment_method').value = '';
        document.getElementById('new_ma_rep_default_currency').value = 'USD';
        document.getElementById('new_ma_rep_bank_name').value = '';
        document.getElementById('new_ma_rep_bank_account').value = '';
        const cliqEl = document.getElementById('new_ma_rep_cliq_alias');
        if (cliqEl) cliqEl.value = '';
        if (typeof window.syncSupplierPaymentMethodFields === 'function') {
            window.syncSupplierPaymentMethodFields('new_ma_rep');
        }
        const contractEl = document.getElementById('new_ma_rep_contract_file');
        if (contractEl) contractEl.value = '';
        document.getElementById('new_ma_rep_tax_number').value = '';
        document.getElementById('new_ma_rep_notes').value = '';
        document.getElementById('add-ma-representative-hub-error')?.classList.add('hidden');
    };

    window.saveNewMeetAssistRepresentative = function saveNewMeetAssistRepresentative() {
        const supplierType = document.getElementById('new_ma_rep_supplier_type').value.trim();
        if (!supplierType) {
            const err = document.getElementById('add-ma-representative-hub-error');
            if (err) {
                err.textContent = 'Please select a supplier type';
                err.classList.remove('hidden');
            }
            return;
        }
        const repName = document.getElementById('new_ma_rep_name').value.trim();
        if (!repName) {
            const err = document.getElementById('add-ma-representative-hub-error');
            if (err) {
                err.textContent = 'Please enter a representative name';
                err.classList.remove('hidden');
            }
            return;
        }
        if (selectedMaRepLanguages.length === 0) {
            const err = document.getElementById('add-ma-representative-hub-error');
            if (err) {
                err.textContent = 'Please select at least one language';
                err.classList.remove('hidden');
            }
            return;
        }
        const financial = getSupplierDialogFinancialFields('new_ma_rep');
        const payload = {
            supplier_type: supplierType,
            name: repName,
            languages: selectedMaRepLanguages.join(', '),
            phone: document.getElementById('new_ma_rep_phone').value.trim(),
            email: document.getElementById('new_ma_rep_email').value.trim(),
            city: document.getElementById('new_ma_rep_city').value.trim(),
            country: document.getElementById('new_ma_rep_country').value.trim(),
            payment_terms: financial.payment_terms,
            payment_method: financial.payment_method || '',
            default_currency: document.getElementById('new_ma_rep_default_currency').value.trim() || 'USD',
            bank_name: financial.bank_name,
            bank_account: financial.bank_account,
            cliq_alias: financial.cliq_alias,
            tax_number: document.getElementById('new_ma_rep_tax_number').value.trim(),
            notes: document.getElementById('new_ma_rep_notes').value.trim()
        };
        const csrfVal = (typeof window.csrfToken !== 'undefined' ? window.csrfToken : '') || '';
        const headers = csrfVal ? { 'X-CSRFToken': csrfVal } : {};
        fetch('/inbound/api/add-ground-handler', {
            method: 'POST',
            headers: headers,
            body: buildSupplierFormData(payload, 'new_ma_rep_contract_file')
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const targetSelectId = window.addRepresentativeTargetSelectId || null;
                if (typeof window.addRepresentativeTargetSelectId !== 'undefined') {
                    window.addRepresentativeTargetSelectId = null;
                }
                const savedName = repName;
                window.closeAddMeetAssistRepresentativeModal();

                function applyMergedRepresentatives(repData) {
                    if (repData && Array.isArray(repData.representatives)
                        && typeof representativesList !== 'undefined') {
                        representativesList = repData.representatives.map(function (r) {
                            return { id: r.id, name: r.name };
                        });
                        if (typeof refreshRepresentativeDropdowns === 'function') {
                            refreshRepresentativeDropdowns();
                        }
                    }
                    if (targetSelectId) {
                        const targetSelect = document.getElementById(targetSelectId);
                        if (targetSelect) targetSelect.value = savedName;
                        if (typeof updateArrivalDriverInSummary === 'function') updateArrivalDriverInSummary();
                        if (typeof updateDepartureDriverInSummary === 'function') updateDepartureDriverInSummary();
                    }
                }

                fetch('/inbound/api/representatives')
                    .then(r => r.json())
                    .then(function (repData) {
                        applyMergedRepresentatives(repData);
                        if (typeof showNotification === 'function') {
                            showNotification('Representative added successfully', 'success');
                        }
                        if (!targetSelectId) {
                            window.location.reload();
                        }
                    })
                    .catch(function () {
                        if (targetSelectId && typeof representativesList !== 'undefined'
                            && !representativesList.find(function (r) { return r.name === savedName; })) {
                            representativesList.push({ id: 0, name: savedName });
                            representativesList.sort(function (a, b) {
                                return (a.name || '').localeCompare(b.name || '');
                            });
                            if (typeof refreshRepresentativeDropdowns === 'function') {
                                refreshRepresentativeDropdowns();
                            }
                            const targetSelect = document.getElementById(targetSelectId);
                            if (targetSelect) targetSelect.value = savedName;
                        }
                        if (typeof showNotification === 'function') {
                            showNotification('Representative added successfully', 'success');
                        }
                        if (!targetSelectId) {
                            window.location.reload();
                        }
                    });
            } else {
                const err = document.getElementById('add-ma-representative-hub-error');
                if (err) {
                    err.textContent = data.error || 'Error adding representative';
                    err.classList.remove('hidden');
                }
            }
        })
        .catch(() => {
            const err = document.getElementById('add-ma-representative-hub-error');
            if (err) {
                err.textContent = 'Error adding representative';
                err.classList.remove('hidden');
            }
        });
    };
})();
</script>

<script>
(function () {
    const isAirlinePage = "meet-assist" === "airline";
    const isTransportationPage = "meet-assist" === "transportation";
    const isGuidesPage = "meet-assist" === "guides";
    const isMeetAssistPage = "meet-assist" === "meet-assist";
    const isRestaurantPage = "meet-assist" === "restaurant";
    const DEFAULT_ROOM_CATEGORIES = ['Standard Rooms', 'Junior Suites', 'Executive Suites', 'Presidential Suites'];
    let globalRoomCategoriesCache = [];
    const overlay = document.getElementById('addHotelModal');
    const transportOverlay = document.getElementById('addTransportModal');
    const airlineOverlay = document.getElementById('addAirlineModal');
    const openBtn = document.getElementById('openQuickSupplierModal');
    const closeBtn = document.getElementById('closeQuickSupplierModal');
    const cancelBtn = document.getElementById('cancelQuickSupplierModal');
    const submitBtn = document.getElementById('submitQuickSupplierModal');
    const paymentMethodSelect = document.querySelector('#addHotelModal select[name="payment_method"]');
    const popupAccommodationCategory = document.getElementById('new_hotel_category');
    const popupAccommodationRoomCategory = document.getElementById('new_hotel_room_category');
    const popupAddRoomCategoryBtn = document.getElementById('popupAddRoomCategoryBtn');

    if (isAirlinePage && airlineOverlay && openBtn) {
        const closeAirlineBtn = document.getElementById('closeQuickAirlineModal');
        const cancelAirlineBtn = document.getElementById('cancelQuickAirlineModal');
        const submitAirlineBtn = document.getElementById('submitQuickAirlineModal');
        openBtn.addEventListener('click', function () { window.openAddAirlineModal(); });
        if (closeAirlineBtn) closeAirlineBtn.addEventListener('click', function () { window.closeAddAirlineModal(); });
        if (cancelAirlineBtn) cancelAirlineBtn.addEventListener('click', function () { window.closeAddAirlineModal(); });
        if (submitAirlineBtn) submitAirlineBtn.addEventListener('click', function () { window.saveNewAirline(); });
        airlineOverlay.addEventListener('click', function (e) {
            if (e.target === airlineOverlay) window.closeAddAirlineModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') window.closeAddAirlineModal();
        });
        return;
    }

    if (isTransportationPage && transportOverlay && openBtn) {
        const closeTransportBtn = document.getElementById('closeQuickTransportModal');
        const cancelTransportBtn = document.getElementById('cancelQuickTransportModal');
        const submitTransportBtn = document.getElementById('submitQuickTransportModal');
        openBtn.addEventListener('click', function () { window.openAddTransportModal(); });
        if (closeTransportBtn) closeTransportBtn.addEventListener('click', function () { window.closeAddTransportModal(); });
        if (cancelTransportBtn) cancelTransportBtn.addEventListener('click', function () { window.closeAddTransportModal(); });
        if (submitTransportBtn) submitTransportBtn.addEventListener('click', function () { window.saveNewTransport(); });
        transportOverlay.addEventListener('click', function (e) {
            if (e.target === transportOverlay) window.closeAddTransportModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') window.closeAddTransportModal();
        });
        return;
    }

    const guideOverlay = document.getElementById('addGuideModal');
    if (isGuidesPage && guideOverlay && openBtn) {
        const closeGuideBtn = document.getElementById('closeQuickGuideModal');
        const cancelGuideBtn = document.getElementById('cancelQuickGuideModal');
        const submitGuideBtn = document.getElementById('submitQuickGuideModal');
        openBtn.addEventListener('click', function () { window.openAddGuideModal(); });
        if (closeGuideBtn) closeGuideBtn.addEventListener('click', function () { window.closeAddGuideModal(); });
        if (cancelGuideBtn) cancelGuideBtn.addEventListener('click', function () { window.closeAddGuideModal(); });
        if (submitGuideBtn) submitGuideBtn.addEventListener('click', function () { window.saveNewGuide(); });
        guideOverlay.addEventListener('click', function (e) {
            if (e.target === guideOverlay) window.closeAddGuideModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') window.closeAddGuideModal();
        });
        return;
    }

    const meetAssistRepresentativeOverlay = document.getElementById('addMeetAssistRepresentativeModal');
    if (isMeetAssistPage && meetAssistRepresentativeOverlay && openBtn) {
        const closeMaRepBtn = document.getElementById('closeQuickMaRepModal');
        const cancelMaRepBtn = document.getElementById('cancelQuickMaRepModal');
        const submitMaRepBtn = document.getElementById('submitQuickMaRepModal');
        openBtn.addEventListener('click', function () { window.openAddMeetAssistRepresentativeModal(); });
        if (closeMaRepBtn) closeMaRepBtn.addEventListener('click', function () { window.closeAddMeetAssistRepresentativeModal(); });
        if (cancelMaRepBtn) cancelMaRepBtn.addEventListener('click', function () { window.closeAddMeetAssistRepresentativeModal(); });
        if (submitMaRepBtn) submitMaRepBtn.addEventListener('click', function () { window.saveNewMeetAssistRepresentative(); });
        meetAssistRepresentativeOverlay.addEventListener('click', function (e) {
            if (e.target === meetAssistRepresentativeOverlay) window.closeAddMeetAssistRepresentativeModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') window.closeAddMeetAssistRepresentativeModal();
        });
        return;
    }

    const restaurantOverlay = document.getElementById('addRestaurantModal');
    if (isRestaurantPage && restaurantOverlay && openBtn) {
        const closeRestaurantBtn = document.getElementById('closeQuickRestaurantModal');
        const cancelRestaurantBtn = document.getElementById('cancelQuickRestaurantModal');
        const submitRestaurantBtn = document.getElementById('submitQuickRestaurantModal');
        openBtn.addEventListener('click', function () { window.openAddRestaurantModal(); });
        if (closeRestaurantBtn) closeRestaurantBtn.addEventListener('click', function () { window.closeAddRestaurantModal(); });
        if (cancelRestaurantBtn) cancelRestaurantBtn.addEventListener('click', function () { window.closeAddRestaurantModal(); });
        if (submitRestaurantBtn) submitRestaurantBtn.addEventListener('click', function () { window.saveNewRestaurant(); });
        restaurantOverlay.addEventListener('click', function (e) {
            if (e.target === restaurantOverlay) window.closeAddRestaurantModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') window.closeAddRestaurantModal();
        });
        return;
    }

    if (!overlay) return;

    function ensureOption(selectEl, value) {
        const val = String(value || '').trim();
        if (!selectEl || !val) return false;
        const exists = Array.from(selectEl.options).some(opt => (opt.value || '').toLowerCase() === val.toLowerCase());
        if (exists) return false;
        const option = document.createElement('option');
        option.value = val;
        option.textContent = val;
        selectEl.appendChild(option);
        return true;
    }

    async function fetchGlobalRoomCategories() {
        try {
            const resp = await fetch('/inbound/api/hotel/room-categories/global');
            const data = await resp.json();
            if (data && data.success && Array.isArray(data.categories)) {
                globalRoomCategoriesCache = data.categories
                    .map(v => String(v || '').trim())
                    .filter(Boolean);
            }
        } catch (_) {}
        return globalRoomCategoriesCache;
    }

    async function persistGlobalRoomCategory(category) {
        const value = String(category || '').trim();
        if (!value) return;
        if (DEFAULT_ROOM_CATEGORIES.some(c => c.toLowerCase() === value.toLowerCase())) return;
        try {
            const resp = await fetch('/inbound/api/hotel/room-categories/global', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category: value })
            });
            if (!resp.ok) throw new Error('failed');
        } catch (_) {
            if (typeof showNotification === 'function') {
                showNotification('Could not save global room category.', 'error');
            }
        }
    }

    function syncAccommodationCategoriesFromHotelTab() {
        if (!popupAccommodationCategory) return;
        let customCategories = [];
        try {
            const raw = localStorage.getItem('custom_other_values_new_hotel_category');
            const parsed = raw ? JSON.parse(raw) : [];
            customCategories = Array.isArray(parsed) ? parsed : [];
        } catch (_) {
            customCategories = [];
        }
        customCategories.forEach(cat => {
            const value = String(cat || '').trim();
            if (!value) return;
            const exists = Array.from(popupAccommodationCategory.options).some(
                opt => (opt.value || '').toLowerCase() === value.toLowerCase()
            );
            if (!exists) {
                const option = document.createElement('option');
                option.value = value;
                option.textContent = value;
                const otherOption = Array.from(popupAccommodationCategory.options).find(opt => opt.value === 'Other');
                if (otherOption) popupAccommodationCategory.insertBefore(option, otherOption);
                else popupAccommodationCategory.appendChild(option);
            }
        });
    }

    async function openRoomCategoryPromptLikeDialog() {
        if (!popupAccommodationRoomCategory) return;
        const existingOverlay = document.getElementById('custom-prompt-overlay');
        if (existingOverlay) existingOverlay.remove();
        const select = popupAccommodationRoomCategory;
        const globalCategories = await fetchGlobalRoomCategories();
        globalCategories.forEach(v => ensureOption(select, v));
        const existingValues = new Set(Array.from(select.options).map(opt => opt.value.toLowerCase()));
        const presets = [
            { value: 'Standard Rooms', label: 'Standard Rooms' },
            { value: 'Junior Suites', label: 'Junior Suites' },
            { value: 'Executive Suites', label: 'Executive Suites' },
            { value: 'Presidential Suites', label: 'Presidential Suites' }
        ];
        const presetValues = presets.map(p => p.value.toLowerCase());
        const savedCustom = (globalCategories || [])
            .filter(v => !presetValues.includes(v.toLowerCase()))
            .map(v => ({ value: v, label: v }));
        const promptOptions = [...presets, ...savedCustom];
        const checkboxHtml = promptOptions.map(p => {
            const checked = existingValues.has(p.value.toLowerCase()) ? ' checked' : '';
            return `<label style="display:flex;align-items:center;gap:8px;font-size:13px;color:#334155;cursor:pointer;"><input type="checkbox" name="room-cat-preset" value="${p.value}"${checked}> ${p.label}</label>`;
        }).join('');
        const overlayPrompt = document.createElement('div');
        overlayPrompt.id = 'custom-prompt-overlay';
        overlayPrompt.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:99999;';
        const dialog = document.createElement('div');
        dialog.style.cssText = 'background:white;border-radius:12px;padding:24px;min-width:360px;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.3);';
        dialog.innerHTML = `
            <div style="font-size:14px;font-weight:600;color:#1e293b;margin-bottom:12px;">Enter new Room Category:</div>
            <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:12px;">
                ${checkboxHtml}
            </div>
            <input type="text" id="custom-prompt-input" style="width:100%;padding:8px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;outline:none;box-sizing:border-box;" placeholder="Or type custom category..." autofocus>
            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
                <button type="button" id="custom-prompt-cancel" style="padding:6px 16px;border:1px solid #cbd5e1;border-radius:6px;background:#f8fafc;color:#475569;font-size:12px;cursor:pointer;">Cancel</button>
                <button type="button" id="custom-prompt-ok" style="padding:6px 16px;border:none;border-radius:6px;background:#3b82f6;color:white;font-size:12px;cursor:pointer;font-weight:500;">Add</button>
            </div>
        `;
        overlayPrompt.appendChild(dialog);
        document.body.appendChild(overlayPrompt);
        const input = document.getElementById('custom-prompt-input');
        const okBtn = document.getElementById('custom-prompt-ok');
        const cancelBtn = document.getElementById('custom-prompt-cancel');
        document.querySelectorAll('input[name="room-cat-preset"]').forEach(cb => {
            cb.addEventListener('change', function() {});
        });
        setTimeout(() => input.focus(), 50);
        async function submit() {
            const checkedList = document.querySelectorAll('input[name="room-cat-preset"]:checked');
            const trimmedInput = input.value.trim();
            const values = Array.from(checkedList).map(cb => cb.value);
            if (trimmedInput) values.push(trimmedInput);
            overlayPrompt.remove();
            if (values.length === 0) return;
            let lastAdded = null;
            values.forEach(trimmed => {
                const exists = Array.from(select.options).some(opt => opt.value.toLowerCase() === trimmed.toLowerCase());
                if (exists) {
                    if (typeof showNotification === 'function') {
                        showNotification('This room category already exists.', 'warning');
                    }
                    lastAdded = trimmed;
                } else {
                    const option = document.createElement('option');
                    option.value = trimmed;
                    option.textContent = trimmed;
                    select.appendChild(option);
                    lastAdded = trimmed;
                }
            });
            await Promise.all(values.map(v => persistGlobalRoomCategory(v)));
            await fetchGlobalRoomCategories();
            if (lastAdded) select.value = lastAdded;
        }
        function cancel() { overlayPrompt.remove(); }
        okBtn.addEventListener('click', submit);
        cancelBtn.addEventListener('click', cancel);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') submit();
            if (e.key === 'Escape') cancel();
        });
        overlayPrompt.addEventListener('click', function(e) {
            if (e.target === overlayPrompt) cancel();
        });
    }

    function closeModal() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        overlay.style.display = 'none';
        overlay.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
    }

    function syncPaymentMethodFields() {
        if (typeof window.syncAccommodationPaymentMethodFields === 'function') {
            window.syncAccommodationPaymentMethodFields();
        }
    }

    function openModal() {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        overlay.style.display = 'flex';
        overlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
        syncAccommodationCategoriesFromHotelTab();
        syncPaymentMethodFields();
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
    if (submitBtn) {
        submitBtn.addEventListener('click', async function () {
            const requiredName = overlay.querySelector('input[name="name"]');
            if (requiredName && !requiredName.value.trim()) {
                requiredName.focus();
                return;
            }
            const url = overlay.getAttribute('data-submit-url');
            if (!url) return;
            const formData = new FormData();
            overlay.querySelectorAll('[name]').forEach(el => {
                if (!(el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement)) return;
                if (el instanceof HTMLInputElement && el.type === 'file') {
                    if (el.files && el.files[0]) formData.append(el.name, el.files[0]);
                } else {
                    formData.append(el.name, el.value || '');
                }
            });
            try {
                const resp = await fetch(url, { method: 'POST', body: formData });
                if (!resp.ok) throw new Error('Save failed');
                window.location.reload();
            } catch (_) {
                alert('Could not save supplier. Please try again.');
            }
        });
    }
    if (popupAddRoomCategoryBtn && popupAccommodationRoomCategory) {
        popupAddRoomCategoryBtn.addEventListener('click', function () {
            openRoomCategoryPromptLikeDialog();
        });
    }
    if (paymentMethodSelect) paymentMethodSelect.addEventListener('change', syncPaymentMethodFields);
    if (overlay) {
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeModal();
        });
    }
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
    });
    syncAccommodationCategoriesFromHotelTab();
    // Keep room-category dropdown in sync with the shared set used by tab dialog.
    if (popupAccommodationRoomCategory) {
        fetchGlobalRoomCategories().then(cats => {
            (cats || []).forEach(v => ensureOption(popupAccommodationRoomCategory, v));
        });
    }
    syncPaymentMethodFields();
})();

function printSuppliersList() {
    const printUrl = new URL('/finance/suppliers/type/meet-assist/print', window.location.origin);
    const params = new URLSearchParams(window.location.search);
    params.forEach(function(value, key) {
        printUrl.searchParams.set(key, value);
    });
    printInPlace(printUrl.toString());
}

function printInPlace(url) {
    let frame = document.getElementById('supplier-print-frame');
    if (!frame) {
        frame = document.createElement('iframe');
        frame.id = 'supplier-print-frame';
        frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden';
        document.body.appendChild(frame);
    }
    frame.onload = function() {
        try {
            frame.contentWindow.focus();
            frame.contentWindow.print();
        } catch (e) {
            alert('Could not open print dialog. Please try again.');
        }
    };
    const sep = url.indexOf('?') >= 0 ? '&' : '?';
    frame.src = url + sep + '_print_ts=' + Date.now();
}
</script>

