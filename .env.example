# Copy to .env and fill in values
# REQUIRED for production deployment - data will NOT persist without PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# For Cloud SQL (unix socket): postgresql://user:password@/database?host=/cloudsql/PROJECT:REGION:INSTANCE
# Set CLOUD_SQL_INSTANCE=PROJECT:REGION:INSTANCE when using Cloud SQL

# Optional - session secret for production
# SESSION_SECRET=your-random-secret
